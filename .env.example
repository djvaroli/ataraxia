# The development edge binds only to loopback. No cloud credentials are needed for
# the development override, which runs in local mode without sign-in.
ATARAXIA_HTTP_PORT=8080

# For running the backend directly; Compose stores the database on its own volume.
ATARAXIA_DATABASE_PATH=data/ataraxia.db

# Sign-in for the runtime stack. `firebase` (the default) needs every value below;
# `local` skips sign-in and serves only requests to localhost from this machine.
# ATARAXIA_AUTH_MODE=firebase
# ATARAXIA_OWNER_UID=<the owner's Firebase user UID>
# ATARAXIA_FIREBASE_PROJECT_ID=<project-id>
# ATARAXIA_FIREBASE_API_KEY=<web API key; public by design>
# ATARAXIA_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
# ATARAXIA_FIREBASE_APP_ID=<web app ID>

# Lessons. The time zone applies until the owner sets one in Settings.
# ATARAXIA_DEFAULT_TIME_ZONE=UTC
# ATARAXIA_MAX_LESSONS_PER_DAY=8
# `claude` (the default) writes lessons with the Claude Code CLI in the worker;
# `fake` writes sample lessons without Claude, for trying the app or for checks.
# ATARAXIA_GENERATOR=claude
# ATARAXIA_CLAUDE_MODEL=opus

# Optional: a one-year token from `claude setup-token`, instead of logging in with
# `docker compose exec -it worker claude auth login`. Keep this file private.
# CLAUDE_CODE_OAUTH_TOKEN=
